rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function phoneVerified() {
      return signedIn()
        && request.auth.token.phone_number is string;
    }

    // Profiles may be fetched by UID, but the collection cannot be enumerated.
    // Clients cannot write profiles directly; the callable function owns writes.
    match /profiles/{userId} {
      allow get: if phoneVerified();
      allow list, create, update, delete: if false;
    }

    // Each user only sees requests in which they participate.
    // Creation and status changes are handled by trusted callable functions.
    match /friendRequests/{requestId} {
      allow get, list: if phoneVerified()
        && (
          resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /friendships/{friendshipId} {
      allow get, list: if phoneVerified()
        && request.auth.uid in resource.data.members;
      allow create, update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow get, list: if phoneVerified()
        && request.auth.uid in resource.data.members;
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if phoneVerified()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.members;
        // The backend creates the fixed phrase and enforces message throttling.
        allow create, update, delete: if false;
      }
    }

    // Rate-limit data is private to server-side Admin SDK code.
    match /_rateLimits/{documentId} {
      allow read, write: if false;
    }

    // Everything not explicitly allowed above is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
